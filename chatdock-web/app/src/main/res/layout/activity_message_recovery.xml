<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7FAF8"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/message_recovery"
        android:textColor="#11352B"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/info_panel"
        android:padding="12dp"
        android:text="@string/message_recovery_note"
        android:textColor="#21483D"
        android:textSize="14sp" />

    <Button
        android:id="@+id/clearRecoveredMessagesButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="14dp"
        android:backgroundTint="#11352B"
        android:text="@string/clear_recovered_messages"
        android:textAllCaps="false"
        android:textColor="#FFFFFF" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/recoveredMessagesView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#11352B"
            android:textSize="15sp" />

    </ScrollView>
</LinearLayout>
