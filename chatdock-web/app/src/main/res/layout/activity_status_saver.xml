<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7FAF8"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/status_saver"
        android:textColor="#11352B"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/statusSaverInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/info_panel"
        android:padding="12dp"
        android:text="@string/status_saver_note"
        android:textColor="#21483D"
        android:textSize="14sp" />

    <Button
        android:id="@+id/pickStatusMediaButton"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="18dp"
        android:backgroundTint="#11352B"
        android:text="@string/pick_status_media"
        android:textAllCaps="false"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/repostStatusMediaButton"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="#18B782"
        android:text="@string/repost_last_saved_status"
        android:textAllCaps="false"
        android:textColor="#FFFFFF" />

</LinearLayout>
